{
  "tesserae_compat": "1.x",
  "name": "Weather Radar",
  "version": "0.1.0",
  "kind": "widget",
  "description": "Static precipitation radar centered on configurable coordinates, using RainViewer and a light town-label map.",
  "icon": "ph-cloud-rain",
  "supports": {
    "sizes": ["xs", "sm", "md", "lg"]
  },
  "cell_options": [
    {
      "name": "latitude",
      "type": "number",
      "label": "Latitude",
      "default": 51.30
    },
    {
      "name": "longitude",
      "type": "number",
      "label": "Longitude",
      "default": 16.90
    },
    {
      "name": "zoom",
      "type": "number",
      "label": "Zoom (1–7)",
      "default": 7
    },
    {
      "name": "title",
      "type": "string",
      "label": "Title",
      "default": "Radar opadów"
    }
  ],
  "requires": [
    "network:api.rainviewer.com"
  ],
  "render": {
    "needs_network": true
  }
}
